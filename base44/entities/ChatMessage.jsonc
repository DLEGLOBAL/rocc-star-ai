{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "risk_level": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "related_contract_id": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "role",
    "content"
  ]
}